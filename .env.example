DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=mesh_lms_db

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_ADMIN=

WHATSAPP_NUMBER=
BASE_URL=

# Opcionales (valores por defecto entre paréntesis)
# Zona horaria de PHP y de la sesión de MariaDB (America/Bogota)
APP_TIMEZONE=America/Bogota
# Carpeta del log de errores; debe quedar fuera de la carpeta pública (../mesh_logs)
# LOG_DIR=/home/usuario/mesh_logs
# Muestra el detalle de los errores 500 en pantalla; nunca en producción (false)
APP_DEBUG=false
# Vencimiento del acceso a cursos y rutas tras el pago (true, 30 días)
ACCESS_EXPIRATION_ENABLED=true
ACCESS_DURATION_DAYS=30

# Credenciales de Zoom (App "Meeting SDK" en Zoom Marketplace)
# ZOOM_SDK_KEY corresponde al "Client ID" (ID de cliente)
ZOOM_SDK_KEY=

# ZOOM_SDK_SECRET corresponde al "Client Secret" (Secreto del cliente)
ZOOM_SDK_SECRET=

# Clave para firmar los códigos de certificado (HMAC). Generar con: php -r "echo bin2hex(random_bytes(32));"
CERT_SECRET=
